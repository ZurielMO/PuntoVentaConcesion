# Apache — DEBE llamarse exactamente ".htaccess"
# Sin DirectoryIndex/AddType (en algunos hostings dan error 500).
# Si en la raíz hay index.php viejo, renómbralo (p. ej. index.php.bak)
# para que Apache sirva index.html.

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^superAdmin/concesiones/[^/]+/?$ superAdmin/concesiones/_/index.html [L]

RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>
